# 복사해서 .env.local 로 쓴다. (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 사장님 카카오 로그인 (서버 전용, NEXT_PUBLIC_ 을 붙이지 않는다). 카카오 개발자 > 앱 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 카카오 지도 JavaScript 키 (공개 키). 카카오 개발자 > 앱 키 > JavaScript 키. 플랫폼 Web 도메인 등록 필요
NEXT_PUBLIC_KAKAO_JS_KEY=

# 휴대폰 알림 (ADR-013). 값은 Vercel 환경변수에만
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hearts2okcheon@gmail.com
PUSH_DISPATCH_SECRET=
