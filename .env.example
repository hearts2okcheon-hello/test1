# 복사해서 .env.local 로 쓴다. (npx supabase start 출력값 또는 Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true면 사장님 로그인 화면에 이메일 로그인이 함께 보인다 (카카오 앱 없이 로컬 테스트용). 프로덕션에서는 끈다.
NEXT_PUBLIC_DEV_EMAIL_LOGIN=true

# supabase/config.toml 의 카카오 로그인용 (로컬). 프로덕션은 Supabase 대시보드 > Auth > Providers > Kakao 에 입력.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
